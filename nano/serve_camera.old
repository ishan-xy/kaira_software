import cv2

# Change this to your laptop's IP
LAPTOP_IP = "192.168.1.15"
PORT = 5000

# # GStreamer pipeline for Jetson Nano CSI camera
# gst_pipeline = (
#     f"nvarguscamerasrc sensor-id=0 ! "
#     f"video/x-raw(memory:NVMM),width=1280,height=720,framerate=30/1 ! "
#     f"nvvidconv ! nvv4l2h264enc bitrate=4000000 insert-sps-pps=true ! "
#     f"rtph264pay config-interval=1 pt=96 ! "
#     f"udpsink host={LAPTOP_IP} port={PORT} sync=false async=false"
# )
# For USB camera
gst_pipeline = (
    f"v4l2src device=/dev/video0 ! "
    f"video/x-raw, width=1280, height=720, framerate=30/1 ! "
    f"videoconvert ! x264enc tune=zerolatency bitrate=4000 speed-preset=superfast ! "
    f"rtph264pay config-interval=1 pt=96 ! udpsink host={LAPTOP_IP} port={PORT} sync=false async=false"
)

print(f"🎥 Starting stream to {LAPTOP_IP}:{PORT}")
cap = cv2.VideoCapture(gst_pipeline, cv2.CAP_GSTREAMER)

if not cap.isOpened():
    raise RuntimeError("❌ Unable to open camera pipeline")

while True:
    ret, frame = cap.read()
    if not ret:
        print("⚠️ Frame capture failed")
        continue
